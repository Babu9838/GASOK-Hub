// ======================================
// GASOK Hub v1.0
// GIWA Wallet Integration
// ======================================

// DOM Elements
const connectBtn = document.getElementById("connectWallet");
const disconnectBtn = document.getElementById("disconnectWallet");
const walletAddress = document.getElementById("walletAddress");
const walletBalance = document.getElementById("walletBalance");
const networkName = document.getElementById("networkName");
const copyBtn = document.getElementById("copyAddress");
const explorerBtn = document.getElementById("viewExplorer");

// Wallet Variables
let provider;
let signer;
let account = null;

// Official GIWA Network
const GIWA = {

    chainId: "0x164CE",

    chainName: "GIWA Sepolia",

    nativeCurrency: {

        name: "ETH",

        symbol: "ETH",

        decimals: 18

    },

    rpcUrls: [

        "https://sepolia-rpc.giwa.io"

    ],

    blockExplorerUrls: [

        "https://sepolia-explorer.giwa.io"

    ]

};

// ===============================
// Switch Network
// ===============================

async function switchNetwork() {

    try {

        await window.ethereum.request({

            method: "wallet_switchEthereumChain",

            params: [

                {

                    chainId: GIWA.chainId

                }

            ]

        });

    }

    catch (error) {

        if (error.code === 4902) {

            await window.ethereum.request({

                method: "wallet_addEthereumChain",

                params: [

                    GIWA

                ]

            });

        }

        else {

            throw error;

        }

    }

}

// ===============================
// Connect Wallet
// ===============================

async function connectWallet() {

    if (!window.ethereum) {

        alert("Please install MetaMask.");

        return;

    }

    try {

        await switchNetwork();

        provider =
            new ethers.providers.Web3Provider(window.ethereum);

        await provider.send(
            "eth_requestAccounts",
            []
        );

        signer =
            provider.getSigner();

        account =
            await signer.getAddress();
        // Wallet Address
        walletAddress.textContent = account;

        // Network Name
        networkName.textContent = "GIWA Sepolia";

        // Short Address on Button
        connectBtn.textContent =
            account.slice(0, 6) +
            "..." +
            account.slice(-4);

        // Explorer Link
        explorerBtn.href =
            "https://sepolia-explorer.giwa.io/address/" +
            account;

        // Get Balance
        const balance =
            await provider.getBalance(account);

        walletBalance.textContent =
            Number(
                ethers.utils.formatEther(balance)
            ).toFixed(4) + " ETH";

        // Save Session
        localStorage.setItem(
            "gasok_wallet",
            account
        );

        console.log(
            "Connected:",
            account
        );

    }

    catch (error) {

        console.error(error);

        alert(
            "Wallet connection failed."
        );

    }

}
// ===============================
// Copy Wallet Address
// ===============================

async function copyAddress() {

    if (!account) {

        alert("Connect your wallet first.");

        return;

    }

    try {

        await navigator.clipboard.writeText(account);

        alert("Wallet address copied!");

    }

    catch (error) {

        console.error(error);

        alert("Copy failed.");

    }

}

// ===============================
// Auto Reconnect
// ===============================

async function autoReconnect() {

    if (!window.ethereum) return;

    const saved =
        localStorage.getItem("gasok_wallet");

    if (!saved) return;

    try {

        provider =
            new ethers.providers.Web3Provider(window.ethereum);

        const accounts =
            await provider.listAccounts();

        if (accounts.length > 0) {

            connectWallet();

        }

    }

    catch (error) {

        console.error(error);

    }

}

// ===============================
// Event Listeners
// ===============================

if (connectBtn) {

    connectBtn.addEventListener(

        "click",

        connectWallet

    );

}

if (disconnectBtn) {

    disconnectBtn.addEventListener(

        "click",

        disconnectWallet

    );

}

if (copyBtn) {

    copyBtn.addEventListener(

        "click",

        copyAddress

    );

}

// ===============================
// MetaMask Events
// ===============================

if (window.ethereum) {

    window.ethereum.on(

        "accountsChanged",

        function () {

            location.reload();

        }

    );

    window.ethereum.on(

        "chainChanged",

        function () {

            location.reload();

        }

    );

}

// ===============================
// Page Load
// ===============================

window.addEventListener(

    "load",

    autoReconnect

);
// ===============================
// Send Native ETH
// ===============================

async function sendNativeToken(receiver, amount) {

    if (!signer) {

        alert("Connect your wallet first.");

        return;

    }

    try {

        const tx = await signer.sendTransaction({

            to: receiver,

            value: ethers.utils.parseEther(amount)

        });

        alert("Transaction Submitted");

        console.log(tx.hash);

        await tx.wait();

        alert("Transaction Confirmed");

        connectWallet();

    }

    catch (error) {

        console.error(error);

        alert(error.message);

    }

}

// ===============================
// Loading Helper
// ===============================

function setLoading(state) {

    if (!connectBtn) return;

    if (state) {

        connectBtn.disabled = true;

        connectBtn.textContent = "Connecting...";

    }

    else {

        connectBtn.disabled = false;

        if (account) {

            connectBtn.textContent =
                account.slice(0, 6) +
                "..." +
                account.slice(-4);

        }

        else {

            connectBtn.textContent =
                "Connect Wallet";

        }

    }

}

