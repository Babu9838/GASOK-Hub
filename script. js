// =======================================
// GASOK Hub v2
// Brave Wallet + MetaMask Support
// =======================================

// DOM Elements
const connectBtn = document.getElementById("connectWallet");
const disconnectBtn = document.getElementById("disconnectWallet");
const walletAddress = document.getElementById("walletAddress");
const walletBalance = document.getElementById("walletBalance");
const networkName = document.getElementById("networkName");
const copyBtn = document.getElementById("copyAddress");
const explorerBtn = document.getElementById("viewExplorer");

// Wallet Variables
let provider = null;
let signer = null;
let account = null;
let ethereum = null;

// GIWA Network
const GIWA = {

    chainId: "0x164CE",

    chainName: "GIWA Sepolia",

    nativeCurrency: {

        name: "Ethereum",

        symbol: "ETH",

        decimals: 18

    },

    rpcUrls: [

        "https://sepolia-rpc.giwa.io"

    ],

    blockExplorerUrls: [

        "https://sepolia-explorer.giwa.io"

    ]

};

// =======================================
// Detect Wallet
// =======================================

function detectWallet() {

    if (!window.ethereum) {

        return null;

    }

    // Multiple Wallets
    if (window.ethereum.providers) {

        const providers =
            window.ethereum.providers;

        // Prefer MetaMask
        let metaMask =
            providers.find(
                p => p.isMetaMask
            );

        if (metaMask) {

            return metaMask;

        }

        // Prefer Brave Wallet
        let brave =
            providers.find(
                p => p.isBraveWallet
            );

        if (brave) {

            return brave;

        }

        return providers[0];

    }

    return window.ethereum;

}

// =======================================
// Switch Network
// =======================================

async function switchGIWA() {

    ethereum = detectWallet();

    if (!ethereum) {

        throw new Error("Wallet not found");

    }

    try {

        await ethereum.request({

            method: "wallet_switchEthereumChain",

            params: [

                {

                    chainId: GIWA.chainId

                }

            ]

        });

    }

    catch (error) {

        if (error.code === 4902) {

            await ethereum.request({

                method: "wallet_addEthereumChain",

                params: [

                    GIWA

                ]

            });

        }

        else {

            throw error;

        }

    }

}
// =======================================
// Connect Wallet
// =======================================

async function connectWallet() {

    try {

        ethereum = detectWallet();

        if (!ethereum) {

            alert("No Web3 wallet found.");

            return;

        }

        await switchGIWA();

        provider =
            new ethers.providers.Web3Provider(ethereum);

        await provider.send(

            "eth_requestAccounts",

            []

        );

        signer =
            provider.getSigner();

        account =
            await signer.getAddress();

        const balance =
            await provider.getBalance(account);

        walletAddress.textContent =
            account;

        walletBalance.textContent =
            parseFloat(

                ethers.utils.formatEther(balance)

            ).toFixed(4) + " ETH";

        networkName.textContent =
            "GIWA Sepolia";

        connectBtn.textContent =
            account.slice(0, 6) +
            "..." +
            account.slice(-4);

        explorerBtn.href =
            "https://sepolia-explorer.giwa.io/address/" +
            account;

        localStorage.setItem(

            "gasok_wallet",

            account

        );

        console.log(

            "Wallet Connected:",

            account

        );

    }

    catch (error) {

        console.error(error);

        alert(

            "Wallet connection failed."

        );

    }

}

// =======================================
// Disconnect Wallet
// =======================================

function disconnectWallet() {

    account = null;

    provider = null;

    signer = null;

    walletAddress.textContent =
        "Not Connected";

    walletBalance.textContent =
        "0 ETH";

    networkName.textContent =
        "Not Connected";

    connectBtn.textContent =
        "Connect Wallet";

    explorerBtn.href = "#";

    localStorage.removeItem(
        "gasok_wallet"
    );

}
// =======================================
// Copy Wallet Address
// =======================================

async function copyAddress() {

    if (!account) {

        alert("Connect your wallet first.");

        return;

    }

    try {

        await navigator.clipboard.writeText(account);

        alert("Wallet address copied.");

    }

    catch (error) {

        console.error(error);

    }

}

// =======================================
// Auto Reconnect
// =======================================

async function autoReconnect() {

    if (!window.ethereum) return;

    const saved =
        localStorage.getItem("gasok_wallet");

    if (!saved) return;

    try {

        ethereum = detectWallet();

        provider =
            new ethers.providers.Web3Provider(ethereum);

        const accounts =
            await provider.listAccounts();

        if (accounts.length > 0) {

            connectWallet();

        }

    }

    catch (error) {

        console.error(error);

    }

}

// =======================================
// Explorer Button
// =======================================

function openExplorer() {

    if (!account) {

        alert("Connect your wallet first.");

        return;

    }

    window.open(

        "https://sepolia-explorer.giwa.io/address/" +
        account,

        "_blank"

    );

}

// =======================================
// Button Events
// =======================================

if (connectBtn) {

    connectBtn.addEventListener(

        "click",

        connectWallet

    );

}

if (disconnectBtn) {

    disconnectBtn.addEventListener(

        "click",

        disconnectWallet

    );

}

if (copyBtn) {

    copyBtn.addEventListener(

        "click",

        copyAddress

    );

}

if (explorerBtn) {

    explorerBtn.addEventListener(

        "click",

        function(e){

            e.preventDefault();

            openExplorer();

        }

    );

}
// =======================================
// Wallet Events
// =======================================

if (window.ethereum) {

    window.ethereum.on(

        "accountsChanged",

        async function (accounts) {

            if (accounts.length === 0) {

                disconnectWallet();

                return;

            }

            connectWallet();

        }

    );

    window.ethereum.on(

        "chainChanged",

        function () {

            window.location.reload();

        }

    );

}

// =======================================
// Auto Load
// =======================================

window.addEventListener(

    "load",

    async function () {

        try {

            await autoReconnect();

        }

        catch (error) {

            console.error(error);

        }

    }

);

// =======================================
// Console
// =======================================

console.log(

    "✅ GASOK Hub v2 Loaded"

);