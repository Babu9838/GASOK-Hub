// -------- Elements --------
const connectBtn = document.getElementById("connectWallet");
const walletAddress = document.getElementById("walletAddress");
const networkName = document.getElementById("networkName");
const explorerBtn = document.getElementById("viewExplorer");

// -------- GIWA Network --------
const GIWA_NETWORK = {
    chainId: "0x164ce",
    chainName: "GIWA Sepolia",
    nativeCurrency: {
        name: "Ethereum",
        symbol: "ETH",
        decimals: 18
    },
    rpcUrls: [
        "https://sepolia-rpc.giwa.io"
    ],
    blockExplorerUrls: [
        "https://sepolia-explorer.giwa.io"
    ]
};

// -------- Add / Switch Network --------
async function addGIWANetwork() {

    try {

        await window.ethereum.request({
            method: "wallet_switchEthereumChain",
            params: [{ chainId: GIWA_NETWORK.chainId }]
        });

    } catch (error) {

        if (error.code === 4902) {

            await window.ethereum.request({
                method: "wallet_addEthereumChain",
                params: [GIWA_NETWORK]
            });

        } else {

            console.error(error);

        }

    }

}

// -------- Connect Wallet --------
async function connectWallet() {

    if (!window.ethereum) {

        alert("Please install MetaMask.");
        return;

    }

    try {

        await addGIWANetwork();

        const provider = new ethers.providers.Web3Provider(window.ethereum);

        await provider.send("eth_requestAccounts", []);

        const signer = provider.getSigner();

        const address = await signer.getAddress();

        walletAddress.textContent = address;

        networkName.textContent = "GIWA Sepolia";

        connectBtn.textContent =
            address.slice(0,6) + "..." + address.slice(-4);

        explorerBtn.href =
            "https://sepolia-explorer.giwa.io/address/" + address;

        localStorage.setItem("walletConnected","true");

    }

    catch(err){

        console.error(err);

    }

}

// -------- Auto Reconnect --------
window.addEventListener("load", async()=>{

    if(
        window.ethereum &&
        localStorage.getItem("walletConnected")
    ){

        connectWallet();

    }

});

// -------- Button --------
if(connectBtn){

    connectBtn.addEventListener(
        "click",
        connectWallet
    );

}