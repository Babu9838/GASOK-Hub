// ------------------------------
// DOM Elements
// ------------------------------
const connectBtn = document.getElementById("connectWallet");
const disconnectBtn = document.getElementById("disconnectWallet");

const walletAddress = document.getElementById("walletAddress");
const walletBalance = document.getElementById("walletBalance");
const networkName = document.getElementById("networkName");

const copyBtn = document.getElementById("copyAddress");
const explorerBtn = document.getElementById("viewExplorer");

// ------------------------------
// Global Variables
// ------------------------------
let provider;
let signer;
let currentAccount = "";

// ------------------------------
// GIWA Network
// ------------------------------
const GIWA_NETWORK = {

    chainId: "0x164ce",

    chainName: "GIWA Sepolia",

    nativeCurrency: {

        name: "Ethereum",
        symbol: "ETH",
        decimals: 18

    },

    rpcUrls: [

        "https://sepolia-rpc.giwa.io"

    ],

    blockExplorerUrls: [

        "https://sepolia-explorer.giwa.io"

    ]

};

// ------------------------------
// Add / Switch Network
// ------------------------------
async function switchToGIWA() {

    if (!window.ethereum) return;

    try {

        await window.ethereum.request({

            method: "wallet_switchEthereumChain",

            params: [
                {
                    chainId: GIWA_NETWORK.chainId
                }
            ]

        });

    }

    catch (error) {

        if (error.code === 4902) {

            await window.ethereum.request({

                method: "wallet_addEthereumChain",

                params: [
                    GIWA_NETWORK
                ]

            });

        } else {

            console.error(error);

        }

    }

}

// ------------------------------
// Connect Wallet
// ------------------------------
async function connectWallet() {

    alert(typeof window.ethereum);

    if (!window.ethereum) {

        alert("Please install MetaMask.");

        return;

    }

// await switchToGIWA();
    ...
}

    try {

        // await switchToGIWA();

        provider =
            new ethers.providers.Web3Provider(window.ethereum);

        await provider.send(
            "eth_requestAccounts",
            []
        );

        signer = provider.getSigner();

        currentAccount =
            await signer.getAddress();

        connectBtn.textContent =
            currentAccount.slice(0, 6) +
            "..." +
            currentAccount.slice(-4);

        walletAddress.textContent =
            currentAccount;

        networkName.textContent =
            "GIWA Sepolia";

        explorerBtn.href =
            "https://sepolia-explorer.giwa.io/address/" +
            currentAccount;

        localStorage.setItem(
            "gasok_wallet",
            "connected"
        );

        console.log(
            "Wallet Connected:",
            currentAccount
        );

    }

    catch (err) {

        console.error(err);

        alert("Wallet connection failed.");

    }

}

// ------------------------------
// Auto Reconnect
// ------------------------------
window.addEventListener(

    "load",

    async () => {

        if (

            window.ethereum &&

            localStorage.getItem("gasok_wallet")

        ) {

            try {

                await connectWallet();

            }

            catch (e) {

                console.log(e);

            }

        }

    }

);

// ------------------------------
// Connect Button
// ------------------------------
if (connectBtn) {

    connectBtn.addEventListener(

        "click",

        connectWallet

    );

}
// ==========================================
// GASOK Hub - script.js (Final v4.0 Part 2)
// ==========================================

// ------------------------------
// Update Wallet Balance
// ------------------------------
async function updateBalance() {

    if (!provider || !currentAccount) return;

    try {

        const balance =
            await provider.getBalance(currentAccount);

        walletBalance.textContent =
            parseFloat(
                ethers.utils.formatEther(balance)
            ).toFixed(4) + " ETH";

    }

    catch (err) {

        console.error(err);

    }

}

// ------------------------------
// Copy Wallet Address
// ------------------------------
if (copyBtn) {

    copyBtn.addEventListener(

        "click",

        async () => {

            if (!currentAccount) {

                alert("Connect your wallet first.");

                return;

            }

            await navigator.clipboard.writeText(currentAccount);

            alert("Wallet address copied!");

        }

    );

}

// ------------------------------
// Disconnect Wallet
// ------------------------------
if (disconnectBtn) {

    disconnectBtn.addEventListener(

        "click",

        () => {

            localStorage.removeItem("gasok_wallet");

            currentAccount = "";

            walletAddress.textContent =
                "Not Connected";

            walletBalance.textContent =
                "0 ETH";

            networkName.textContent =
                "Not Connected";

            explorerBtn.href = "#";

            connectBtn.textContent =
                "Connect Wallet";

            alert("Wallet disconnected.");

        }

    );

}

// ------------------------------
// Account Changed
// ------------------------------
if (window.ethereum) {

    window.ethereum.on(

        "accountsChanged",

        async (accounts) => {

            if (accounts.length === 0) {

                disconnectBtn.click();

                return;

            }

            currentAccount = accounts[0];

            walletAddress.textContent =
                currentAccount;

            connectBtn.textContent =
                currentAccount.slice(0, 6) +
                "..." +
                currentAccount.slice(-4);

            explorerBtn.href =
                "https://sepolia-explorer.giwa.io/address/" +
                currentAccount;

            await updateBalance();

        }

    );

    window.ethereum.on(

        "chainChanged",

        () => {

            window.location.reload();

        }

    );

}

// ------------------------------
// Refresh Balance After Connect
// ------------------------------
const originalConnect = connectWallet;

connectWallet = async function () {

    await originalConnect();

    await updateBalance();

};

console.log("✅ GASOK Hub Ready");